[Unit]
Description=Run EveryLot Chicago every 15 minutes during production posting hours

[Timer]
# Matches the PM2 schedule observed on 2026-07-26: 80 runs/day in UTC.
OnCalendar=*-*-* 00..07,12..23:00/15:00 UTC
# Missed social posts must not be replayed as a burst when the host returns.
Persistent=false
AccuracySec=1s
Unit=everylotbot.service

[Install]
WantedBy=timers.target
