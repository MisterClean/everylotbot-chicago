#!/usr/bin/env bash
# Code-only deployment. No schema migrations, live posts, credential writes, or
# log deletion. Rollback uses the same path with an earlier published commit.
set -Eeuo pipefail
umask 0027
readonly REPOSITORY=MisterClean/everylotbot-chicago
readonly ROOT=/opt/everylotbot
readonly STATE=/var/lib/everylotbot
readonly DATABASE=/home/ubuntu/bots/everylotbot-chicago/cook_county_lots.db
readonly BASE="https://github.com/${REPOSITORY}/releases/download"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }
fail() { log "ERROR: $*" >&2; exit 1; }
[[ $EUID == 0 ]] || fail 'Run as root'
release=production
if (($#)); then
  [[ $# == 2 && $1 == --commit && $2 =~ ^[0-9a-f]{40}$ ]] || fail 'Usage: deploy-everylotbot [--commit <full SHA>]'
  release="app-$2"
fi
for command in curl jq sqlite3 sha256sum flock systemd-run; do
  command -v "$command" >/dev/null || fail "Missing $command"
done
[[ -s $DATABASE && -r /etc/everylotbot.env ]] || fail 'Production state is missing'
exec 9>>/run/lock/everylotbot-deploy.lock
flock -n 9 || exit 0
install -d -m 0755 "$ROOT" "$ROOT/releases"
work=$(mktemp -d "$ROOT/.candidate.XXXXXX")
shadow=''
pointer=''
cleanup() {
  rm -rf -- "$work"
  [[ -z $shadow ]] || rm -f -- "$shadow"
  [[ -z $pointer ]] || rm -f -- "$pointer"
}
trap cleanup EXIT
status=$(curl --silent --show-error --location --proto '=https' --proto-redir '=https' \
  --connect-timeout 15 --max-time 90 --max-filesize 16384 \
  --output "$work/production.json" --write-out '%{http_code}' "$BASE/$release/production.json")
if [[ $status == 404 && $release == production ]]; then
  log 'No native production release published yet'; exit 0
fi
[[ $status == 200 ]] || fail "Manifest download returned HTTP $status"
jq -e '.schema == 1 and .platform == "linux-x86_64" and
  (.commit | type == "string" and test("^[0-9a-f]{40}$")) and
  (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))' "$work/production.json" >/dev/null || fail 'Invalid release manifest'
commit=$(jq -r .commit "$work/production.json")
digest=$(jq -r .sha256 "$work/production.json")
[[ $release == production || $release == "app-$commit" ]] || fail 'Commit does not match release'
candidate="$ROOT/releases/$commit"
if [[ $(readlink "$ROOT/current" || true) == "$candidate" ]]; then
  [[ $(sha256sum "$candidate/everylotbot" | cut -d' ' -f1) == "$digest" ]] || fail 'Installed executable checksum changed'
  log "Already deployed $commit"; exit 0
fi
free=$(df --output=avail -B1 "$ROOT" | tail -1 | tr -d ' ')
((free > 256 * 1024 * 1024)) || fail 'Less than 256 MiB free for backup and validation'
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
  --connect-timeout 15 --max-time 180 --max-filesize 33554432 \
  --output "$work/everylotbot" "$BASE/app-$commit/everylotbot-linux-x86_64"
printf '%s  %s\n' "$digest" "$work/everylotbot" | sha256sum --check --status || fail 'Executable checksum mismatch'
chmod 0755 "$work/everylotbot"
# Serialize with all normal posts, including the old container during cutover.
exec 8>>"$STATE/post.lock"
flock --wait 1200 8
stamp=$(date -u +%Y%m%dT%H%M%SZ)
install -d -m 0700 "$STATE/deploy-backups" "$STATE/deployments"
install -d -m 0750 -o ubuntu -g ubuntu "$STATE/deploy-shadow"
backup="$STATE/deploy-backups/$stamp-$commit.sqlite3"
shadow="$STATE/deploy-shadow/$stamp-$commit.sqlite3"
before=$(sha256sum "$DATABASE" | cut -d' ' -f1)
# The source connection is explicitly read-only; .backup writes a NEW file.
sqlite3 -readonly "$DATABASE" '.timeout 30000' ".backup '$backup'"
[[ $(sqlite3 -readonly "$backup" 'PRAGMA integrity_check;') == ok ]] || fail 'Backup integrity failed'
cp -- "$backup" "$shadow"
chown ubuntu:ubuntu "$shadow"
chmod 0640 "$shadow"
shadow_before=$(sha256sum "$shadow" | cut -d' ' -f1)
chmod 0755 "$work"
# No credentials or network are available to candidate validation. Systemd
# additionally mounts all persistent state read-only for this transient unit.
for action in audit post-next; do
  args=("$action" --database "$shadow")
  [[ $action != post-next ]] || args+=(--dry-run)
  systemd-run --quiet --wait --pipe --collect \
    --property=User=ubuntu --property=Group=ubuntu \
    --property=WorkingDirectory=/ --property=PrivateNetwork=yes \
    --property=ProtectSystem=strict --property=ProtectHome=yes \
    --property=NoNewPrivileges=yes --property=PrivateTmp=yes \
    --property=MemoryMax=64M --property=MemorySwapMax=0 \
    --property=RuntimeMaxSec=120 --property=TasksMax=16 \
    --setenv=DATABASE_PATH="$shadow" --setenv=PLATFORMS=bluesky \
    "$work/everylotbot" "${args[@]}"
done
[[ $(sha256sum "$shadow" | cut -d' ' -f1) == "$shadow_before" ]] || fail 'Validation modified shadow data'
[[ $(sha256sum "$DATABASE" | cut -d' ' -f1) == "$before" ]] || fail 'Live database changed during deployment; pointer untouched'
if [[ -e $candidate ]]; then
  [[ $(sha256sum "$candidate/everylotbot" | cut -d' ' -f1) == "$digest" ]] || fail 'Immutable release collision'
else
  install -d -m 0755 "$candidate"
  install -m 0755 "$work/everylotbot" "$candidate/everylotbot"
  install -m 0644 "$work/production.json" "$candidate/production.json"
fi
previous=$(readlink "$ROOT/current" || true)
# mv replaces the symlink atomically; a running executable remains valid.
pointer="$ROOT/.current-$stamp-$$"
ln -s "$candidate" "$pointer"
mv -Tf "$pointer" "$ROOT/current"
pointer=''
jq --arg previous "$previous" --arg backup "$backup" --arg database_sha256 "$before" \
  '. + {previous: $previous, backup: $backup, database_sha256: $database_sha256}' \
  "$work/production.json" >"$STATE/deployments/$stamp-$commit.json"
log "Deployed $commit; database unchanged ($before); previous=$previous"
