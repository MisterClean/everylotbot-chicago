[Unit]
Description=EveryLot Chicago Bluesky Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/everylotbot/current
EnvironmentFile=/etc/everylotbot.env
Environment=NODE_OPTIONS=--max-old-space-size=96
ExecStart=/usr/bin/flock -n -E 75 /var/lib/everylotbot/post.lock /opt/node-v24/bin/node /opt/everylotbot/current/dist/src/cli/post-next.js --database /home/ubuntu/bots/everylotbot-chicago/cook_county_lots.db
TimeoutStartSec=10min
MemoryMax=192M
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bots/everylotbot-chicago /var/lib/everylotbot
