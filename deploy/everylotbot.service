[Unit]
Description=EveryLot Chicago native manual invocation (scheduled by Petit)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/everylotbot/current/everylotbot

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/lib/everylotbot
ExecStart=/usr/local/libexec/run-everylotbot
TimeoutStartSec=1200
MemoryMax=96M
MemorySwapMax=0
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/everylotbot /var/log/everylotbot /home/ubuntu/bots/everylotbot-chicago
UMask=0027
