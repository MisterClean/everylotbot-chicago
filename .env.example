# Cook County Open Data
CHICAGO_DATA_PORTAL_TOKEN=your_token_here

# Google Street View Static API
GOOGLE_API_KEY=your_google_api_key

# Bluesky
BLUESKY_IDENTIFIER=your.bsky.social
BLUESKY_PASSWORD=your_password
BLUESKY_SERVICE=https://bsky.social
BLUESKY_SESSION_PATH=var/bluesky-session.json

# Twitter (optional)
TWITTER_CONSUMER_KEY=your_consumer_key
TWITTER_CONSUMER_SECRET=your_consumer_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# Toggles
ENABLE_TWITTER=false
ENABLE_BLUESKY=true

# Required only when enabling Twitter; prevents accidental historical backfill
TWITTER_START_PIN10=

# Post formatting
PRINT_FORMAT={address}

# Camera Settings
STREETVIEW_PITCH=11.55
STREETVIEW_ZOOM=.9
STREETVIEW_RADIUS_METERS=500

# Networking and overlap protection
HTTP_TIMEOUT_MS=30000
LEASE_SECONDS=840

# Database
DATABASE_PATH=cook_county_lots.db
